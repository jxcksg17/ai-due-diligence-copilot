# Copy this file to `.env` and fill in real values for local development.
# `.env` itself is gitignored — never commit real credentials.

APP_NAME=AI Due Diligence Copilot
APP_ENV=development
DEBUG=true

# SQLAlchemy connection string for PostgreSQL.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://dd_user:dd_password@localhost:5432/dd_copilot

# M3 embeddings. The default is local BGE inference on this machine.
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
# Only needed when EMBEDDING_PROVIDER=openai. Keep it out of source control.
OPENAI_API_KEY=

# M3 grounded generation. Ollama runs the pinned Qwen model locally.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b-q4_K_M
OLLAMA_HOST=http://localhost:11434
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=512

# M6 hybrid retrieval and local cross-encoder reranking.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_K=20
RERANKER_BATCH_SIZE=8
HYBRID_RRF_K=60

# M7 local citation entailment verification.
CITATION_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-small
CITATION_VERIFIER_BATCH_SIZE=8
